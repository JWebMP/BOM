            <!-- ═══════════════════════════════════════════════════════════════ -->

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>easing-effects</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>jquery</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>jquery-ui</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>globalize</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>bootstrap</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>data-tables</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>waveseffect</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>prism</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>ngx-markdown</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Restored Legacy Plugins                                        -->
            <!-- ═══════════════════════════════════════════════════════════════ -->

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>toastr</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>prettify</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>waypoints</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>plus-as-tab</artifactId>
