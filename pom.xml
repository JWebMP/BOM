<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.guicedee</groupId>
        <artifactId>versioner</artifactId>
        <version>2.0.3-SNAPSHOT</version>
    </parent>

    <groupId>com.jwebmp</groupId>
    <artifactId>jwebmp-bom</artifactId>
    <packaging>pom</packaging>
    <version>2.1.0-SNAPSHOT</version>

    <name>JWebMP BOM</name>
    <description>Bill of Materials for JWebMP — centralizes compatible dependency versions for all JWebMP modules and plugins.</description>
    <url>https://jwebmp.com</url>

    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/JWebMP/BOM</url>
        <connection>scm:git:https://github.com/JWebMP/BOM.git</connection>
        <developerConnection>scm:git:https://github.com/JWebMP/BOM.git</developerConnection>
    </scm>

    <developers>
        <developer>
            <id>GedMarc</id>
            <name>Marc Magon</name>
            <email>marc.magon@gmail.com</email>
            <url>https://github.com/GedMarc</url>
        </developer>
    </developers>

    <properties>
        <project.scm.nameUrl>/JWebMP/BOM</project.scm.nameUrl>
        <project.scm.packages>/JWebMP/Packages</project.scm.packages>
        <guicedee.version>2.0.2</guicedee.version>
        <jwebmp.version>2.1.0-SNAPSHOT</jwebmp.version>
    </properties>

    <dependencyManagement>
        <dependencies>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- GuicedEE                                                        -->
            <!-- ═══════════════════════════════════════════════════════════════ -->

            <dependency>
                <groupId>com.guicedee</groupId>
                <artifactId>inject</artifactId>
                <version>${guicedee.version}</version>
            </dependency>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Core                                                            -->
            <!-- ═══════════════════════════════════════════════════════════════ -->

            <dependency>
                <groupId>com.jwebmp</groupId>
                <artifactId>jwebmp-client</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp</groupId>
                <artifactId>jwebmp-core</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.core</groupId>
                <artifactId>testlib</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Runtime / Connectivity                                          -->
            <!-- ═══════════════════════════════════════════════════════════════ -->

            <dependency>
                <groupId>com.jwebmp</groupId>
                <artifactId>jwebmp-vertx</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp</groupId>
                <artifactId>jwebmp-rabbitmq</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Angular / TypeScript                                            -->
            <!-- ═══════════════════════════════════════════════════════════════ -->

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>angular</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>angular-forms</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>angular-maven-plugin</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>


            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>angular-material</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>typescript-client</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- UI Component Libraries                                          -->
            <!-- ═══════════════════════════════════════════════════════════════ -->

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>web-awesome</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>web-awesome-pro</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Data Grids — AG Grid                                            -->
            <!-- ═══════════════════════════════════════════════════════════════ -->

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>aggrid</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>aggrid-enterprise</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Charting                                                        -->
            <!-- ═══════════════════════════════════════════════════════════════ -->

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>agcharts</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>agcharts-enterprise</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>chartjs</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Calendar                                                        -->
            <!-- ═══════════════════════════════════════════════════════════════ -->

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>full-calendar</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>full-calendar-pro</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Icon Sets                                                       -->
            <!-- ═══════════════════════════════════════════════════════════════ -->

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>font-awesome</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>font-awesome-pro</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>themify-icons</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>material-icons</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>material-design-icons</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>weather-icons</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>glyphicons</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>skycons</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Charts & Graphing                                               -->
            <!-- ═══════════════════════════════════════════════════════════════ -->

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>c3</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>d3</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>jqplot</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.jwebmp.plugins</groupId>
                <artifactId>easy-pie-chart</artifactId>
                <version>${jwebmp.version}</version>
            </dependency>

            <!-- ═══════════════════════════════════════════════════════════════ -->
